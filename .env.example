# Bot Configuration
BOT_TOKEN=
CHANNEL=@
GROUP=-100
ALLOWED_USER_ID=
ALERT_CHAT_ID=alert_chat_id

WEBHOOK_DOMAIN=https://example.com       # если задан — включается webhook
WEBHOOK_PATH=/telegraf/секретный-путь    # опционально, по умолчанию /telegraf/{BOT_TOKEN}
WEBHOOK_PORT=8443                        # опционально, по умолчанию 8443
WEBHOOK_SECRET_TOKEN=любая-строка        # опционально, доп. проверка Telegram 

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Feature Flags
FF_USERS_DB=true
FF_REDIS_LIMITS=true
FF_REDIS_CACHE=false  # Пока можно отключить, если не нужен кэш в Redis
FF_ANALYTICS=true
FF_QUALITY_CHECK=false

# Rate Limiting
REQUESTS_PER_MINUTE=10
REQUESTS_PER_HOUR=50
REQUESTS_PER_DAY=200
AUDIO_PER_HOUR=5
AUDIO_PER_DAY=20
MAX_AYAHS_PER_REQUEST=50

# Other Configuration
TEMP_FOLDER=./temp
MAX_FILE_SIZE=52428800
MAX_AYAHS=20
SESSION_TIMEOUT=3600000
CACHE_TTL=1800000
BATCH_SIZE=5
MAX_CONCURRENT_PROCESSES=3
MEMORY_CLEANUP_INTERVAL=600000
LOG_LEVEL=info