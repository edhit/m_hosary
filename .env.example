# ================================================================
# ОБЩИЙ .env ДЛЯ ДВУХ БОТОВ
#   bot.js            — основной @mmmm_hosary_bot
#   publisher-bot.js  — бот-публикатор (склейка аятов + запись file_id)
# ================================================================

# ---------------- Bot Configuration ----------------
# Токен основного бота @mmmm_hosary_bot.
# ВНИМАНИЕ: этот токен был отправлен в переписку — отзовите его
# через @BotFather (/revoke) и вставьте сюда новый.
BOT_TOKEN=

CHANNEL=@m_al_hosary
GROUP=-1003926306101
ALLOWED_USER_ID=240400422
ALERT_CHAT_ID=240400422

# ---------------- Бот-публикатор ----------------
# Токен НОВОГО бота. Получить у @BotFather: /newbot
BOT2_TOKEN=

# Токен, которым выполняется загрузка и публикация в канал.
# Оставьте пустым — publisher-bot.js подхватит BOT_TOKEN выше.
# Заполняйте, только если боты разнесены по разным .env.
HOSARY_BOT_TOKEN=

# Username основного бота — для ссылок вида ?start=s5_a57
HOSARY_BOT_USERNAME=mmmm_hosary_bot

# Чат, куда основной бот заливает черновик, чтобы получить file_id.
# Ваш личный id подходит (переписка с ботом уже начата).
DRAFT_CHAT_ID=240400422

# Путь к общему журналу публикаций
AUDIO_DATA_FILE=./audio_data.json

# Исполнитель в ID3-тегах и подписях
ARTIST=Mahmoud Al-Hosary

# ---------------- Webhook (только основной бот) ----------------
# WEBHOOK_DOMAIN=https://example.com       # если задан — включается webhook
# WEBHOOK_PATH=/telegraf/секретный-путь    # опционально, по умолчанию /telegraf/{BOT_TOKEN}
# WEBHOOK_PORT=8443                        # опционально, по умолчанию 8443
# WEBHOOK_SECRET_TOKEN=любая-строка        # опционально, доп. проверка Telegram

# ---------------- Redis ----------------
REDIS_URL=redis://localhost:6379

# ---------------- Feature Flags ----------------
FF_USERS_DB=true
FF_REDIS_LIMITS=true
FF_REDIS_CACHE=false
FF_ANALYTICS=true
FF_QUALITY_CHECK=false

# ---------------- Rate Limiting ----------------
REQUESTS_PER_MINUTE=10
REQUESTS_PER_HOUR=50
REQUESTS_PER_DAY=200
AUDIO_PER_HOUR=5
AUDIO_PER_DAY=20
MAX_AYAHS_PER_REQUEST=50

# ---------------- Other Configuration ----------------
TEMP_FOLDER=./temp
MAX_FILE_SIZE=52428800
MAX_AYAHS=20
SESSION_TIMEOUT=3600000
CACHE_TTL=1800000
BATCH_SIZE=5
MAX_CONCURRENT_PROCESSES=3
MEMORY_CLEANUP_INTERVAL=600000
LOG_LEVEL=info